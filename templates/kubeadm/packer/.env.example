# Copy to .env (git-ignored) for `make xcpng`. Variables of
# almalinux-10-k8s-xcpng.pkr.hcl, read by Packer as PKR_VAR_<name>.
#
# The file is sourced by the shell: single-quote every value, or the shell
# eats the double quotes an HCL list needs and splits on spaces.
PKR_VAR_remote_host='xcp-ng-pool-primary.example.org'
PKR_VAR_remote_username='root'
PKR_VAR_remote_password=''
PKR_VAR_sr_name='Local storage'
# Optional:
# PKR_VAR_iso_name=''   # default: AlmaLinux-10-latest-x86_64_v2-dvd.iso, already in the pool; '' downloads it
# PKR_VAR_network_names='["Pool-wide network associated with eth0"]'
# PKR_VAR_export_xva='true'   # also download the template as an XVA
