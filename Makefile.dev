CONTAINER_TOOL ?= $(shell command -v podman 2>/dev/null || command -v docker 2>/dev/null)
NS ?= capi-system
DEPLOY ?= vates-capi-controller-manager

# A unique dev tag per invocation so kubelet is forced to pull the fresh image
# (a plain :latest + imagePullPolicy=IfNotPresent does not re-resolve).
ifeq ($(origin IMG), undefined)
IMG := ghcr.io/vatesfr/cluster-api-provider-vates:dev-$(shell date +%s)
endif

.PHONY: build push deploy-image ensure-image restart dev

build:
	$(MAKE) docker-build IMG=$(IMG)

push:
	rm -f /tmp/vates-capi-dev.tar && \
	$(CONTAINER_TOOL) save $(IMG) -o /tmp/vates-capi-dev.tar && \
	kind load image-archive /tmp/vates-capi-dev.tar --name kind

# Image currently configured in the deployment.
deploy-image:
	@kubectl -n $(NS) get deployment/$(DEPLOY) -o jsonpath='{.spec.template.spec.containers[0].image}'

ensure-image:
	@current=$$( $(MAKE) -s deploy-image ); \
	echo "built   : $(IMG)"; \
	echo "deployed: $$current"; \
	if [ "$$current" != "$(IMG)" ]; then \
		echo ">> setting deployment image to $(IMG)"; \
		kubectl -n $(NS) set image deployment/$(DEPLOY) manager=$(IMG); \
	fi; \
	kubectl -n $(NS) rollout restart deployment/$(DEPLOY); \
	kubectl -n $(NS) rollout status deployment/$(DEPLOY) --timeout=5m; \
	pod=$$(kubectl -n $(NS) get pod -l app.kubernetes.io/name=vates-capi -o jsonpath='{.items[0].metadata.name}'); \
	run=$$(kubectl -n $(NS) get pod $$pod -o jsonpath='{.status.containerStatuses[0].image}'); \
	echo "running : $$run"; \
	if [ "$$run" = "$(IMG)" ]; then \
		echo "OK: deployment runs $(IMG)"; \
	else \
		echo "WARN: pod runs $$run, expected $(IMG)"; \
	fi

restart:
	kubectl -n $(NS) rollout restart deployment/$(DEPLOY)
	kubectl -n $(NS) rollout status deployment/$(DEPLOY) --timeout=5m

# Refresh the local clusterctl overrides + config from dist/ for development.
# dist/ itself cannot be pointed at directly: a file:// url requires a
# {basepath}/{provider-name}/{version}/ layout for version resolution.
.PHONY: dev-overrides
dev-overrides:
	$(MAKE) release-manifests IMG=$(IMG)
	@mkdir -p "$(HOME)/.config/cluster-api/overrides/infrastructure-vates/v0.1.0"
	@cp dist/infrastructure-components.yaml dist/metadata.yaml dist/cluster-template.yaml "$(HOME)/.config/cluster-api/overrides/infrastructure-vates/v0.1.0/"
	@if [ ! -f "$(HOME)/.config/cluster-api/clusterctl.yaml" ]; then \
		echo "Creating $(HOME)/.config/cluster-api/clusterctl.yaml"; \
		{ echo 'providers:'; echo '  - name: vates'; echo '    type: InfrastructureProvider'; echo "    url: file://\$${HOME}/.config/cluster-api/overrides/infrastructure-vates/v0.1.0/infrastructure-components.yaml"; } > "$(HOME)/.config/cluster-api/clusterctl.yaml"; \
	elif ! grep -q 'name: vates' "$(HOME)/.config/cluster-api/clusterctl.yaml"; then \
		echo "WARNING: vates provider not registered in $(HOME)/.config/cluster-api/clusterctl.yaml — add it manually (see README)"; \
	fi
	@echo "clusterctl overrides refreshed from dist/"

dev: build push ensure-image